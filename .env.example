# Database Configurations
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DB=beverage_db

# Local Ollama LLM Configuration
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2
# Local CPU-only vision; download this model once before offline use.
OLLAMA_VISION_MODEL=qwen3-vl:2b-instruct
OLLAMA_VISION_TIMEOUT=300
OLLAMA_VISION_MAX_TOKENS=512
OLLAMA_VISION_IMAGE_SIZE=512

# Application Port
PORT=5000

